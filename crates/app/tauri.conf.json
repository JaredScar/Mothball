{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mothball",
  "version": "0.1.0",
  "identifier": "com.mothball.app",
  "build": {
    "frontendDist": "../../ui/dist/ui/browser",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm --prefix ../../ui start",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
