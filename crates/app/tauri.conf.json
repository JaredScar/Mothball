{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mothball",
  "version": "0.1.0",
  "identifier": "com.mothball.desktop",
  "build": {
    "frontendDist": "../../ui/dist/ui/browser",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "script": "npm start",
      "cwd": "../../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mothball",
    "category": "DeveloperTool",
    "shortDescription": "Deletes regenerable dev folders from projects you have not touched.",
    "longDescription": "Mothball finds dev projects you have not touched in a while and deletes only the folders a lockfile can rebuild. Source code stays.",
    "copyright": "Copyright (c) 2026 Mothball contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
